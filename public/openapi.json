{
  "openapi": "3.1.0",
  "info": {
    "title": "ura's notes public content",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://urarara.me"
    }
  ],
  "security": [],
  "paths": {
    "/llms.txt": {
      "get": {
        "summary": "Site overview and recent articles",
        "responses": {
          "200": {
            "description": "Site overview and recent articles",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/feed.xml": {
      "get": {
        "summary": "RSS feed",
        "responses": {
          "200": {
            "description": "RSS feed",
            "content": {
              "application/rss+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/atom.xml": {
      "get": {
        "summary": "Atom feed",
        "responses": {
          "200": {
            "description": "Atom feed",
            "content": {
              "application/atom+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read blog content as HTML or Markdown",
        "parameters": [
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string"
            },
            "example": "text/markdown"
          }
        ],
        "responses": {
          "200": {
            "description": "Page content",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/posts": {
      "get": {
        "summary": "Read blog content as HTML or Markdown",
        "parameters": [
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string"
            },
            "example": "text/markdown"
          }
        ],
        "responses": {
          "200": {
            "description": "Page content",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/posts/{slug}": {
      "get": {
        "summary": "Read blog content as HTML or Markdown",
        "parameters": [
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string"
            },
            "example": "text/markdown"
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page content",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Article not found"
          }
        }
      }
    }
  }
}
