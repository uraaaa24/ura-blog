{
  "name": "ura-notes",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "app": "pnpm run build && pnpm run start",
    "watch": "tsc --watch",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "check:staged": "biome check --staged --no-errors-on-unmatched",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@twemoji/api": "^17.0.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/eslintrc": "^3.3.7",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/nextjs": "^10.6.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.184.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
